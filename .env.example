# --- runtime ---
NODE_ENV=development
PORT=8000
TZ=Europe/Helsinki
LOG_LEVEL=info

# --- database ---
# docker compose overrides this to point at the `db` service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentry_alert_bridge

# --- sentry ---
# https://toska.it.helsinki.fi/settings/sentry/developer-settings/sentry-alert-bridge-c1b5c5/
SENTRY_BASE_URL=https://toska.it.helsinki.fi
SENTRY_ORG_SLUG=sentry
# "Token" on the integration page. Required: polling is the default ingest mode.
SENTRY_AUTH_TOKEN=
# "Client Secret" on the integration page. Only needed for webhook mode.
SENTRY_CLIENT_SECRET=
POLL_INTERVAL_MINUTES=5
INGEST_MODE_DEFAULT=polling

# --- secrets ---
# openssl rand -hex 32
ACCESS_TOKEN=
# openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=24
