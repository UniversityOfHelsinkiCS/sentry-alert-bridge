# --- runtime ---
NODE_ENV=development
PORT=8000
TZ=Europe/Helsinki
LOG_LEVEL=info

# --- database ---
# docker compose overrides this to point at the `db` service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentry_alert_bridge

# --- sentry ---
# https://toska.it.helsinki.fi/settings/sentry/developer-settings/sentry-alert-bridge-c1b5c5/
SENTRY_BASE_URL=https://toska.it.helsinki.fi
SENTRY_ORG_SLUG=sentry
# "Token" on the integration page. Required.
SENTRY_AUTH_TOKEN=
# Optional. Seeds the stored poll interval when the database is first created;
# after that it is edited in the Settings page. Unset falls back to the built-in
# default in src/server/defaults.ts.
POLL_INTERVAL_MINUTES=5
# Optional, same story: seeds the stored default re-alert cooldown, then edited
# in Settings. A project can override it on the Routing page.
ALERT_COOLDOWN_MINUTES=60

# --- slack ---
# App-level token (connections:write) from the Slack app's Basic Information
# page. Enables Socket Mode and the "Resolve" button on alerts. Optional.
SLACK_APP_TOKEN=

# --- secrets ---
# openssl rand -hex 32
ACCESS_TOKEN=
# openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=24
